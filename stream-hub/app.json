{
  "expo": {
    "name": "StreamHub",
    "slug": "streamhub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.streamhub.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0E"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "backgroundColor": "#0A0A0E",
      "resizeMode": "contain"
    }
  }
}